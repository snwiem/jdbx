#!/bin/sh
# jdbx wrapper: finds a Java 25+ and the jdbx jar, then execs the jar.
# Arguments, stdin, signals and exit code are those of the jar.
#
# Jar lookup:  $JDBX_JAR, <script dir>/jdbx.jar, <script dir>/../lib/jdbx.jar,
#              <repo root>/target/jdbx-*.jar
# Java lookup: $JDBX_JAVA, $JAVA_HOME/bin/java, java on PATH (must be >= 25)
# JVM options: $JDBX_OPTS (split at whitespace, placed before -jar)
# Exit codes of the wrapper itself: 127 no suitable Java, 1 jar not found.

REQUIRED_JAVA=25

die() { # exit-code message...
	code=$1; shift
	printf 'jdbx: %s\n' "$*" >&2
	exit "$code"
}

# Resolve the script's real path through symlinks.
script=$0
while [ -h "$script" ]; do
	link=$(readlink "$script")
	case $link in
		/*) script=$link ;;
		*) script=$(dirname "$script")/$link ;;
	esac
done
script_dir=$(cd "$(dirname "$script")" && pwd -P) || die 1 "cannot resolve script directory"

# Print the major version of the java command $1, or nothing.
java_major() {
	"$1" -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -n 1 | {
		read -r v || exit 0
		case $v in 1.*) v=${v#1.} ;; esac
		v=${v%%[!0-9]*}
		printf '%s' "$v"
	}
}

java_ok() {
	[ -x "$1" ] || return 1
	major=$(java_major "$1")
	case $major in
		'' | *[!0-9]*) return 1 ;;
	esac
	[ "$major" -ge "$REQUIRED_JAVA" ]
}

java=
if [ -n "$JDBX_JAVA" ]; then
	java_ok "$JDBX_JAVA" && java=$JDBX_JAVA
elif [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
	java_ok "$JAVA_HOME/bin/java" && java=$JAVA_HOME/bin/java
else
	path_java=$(command -v java 2>/dev/null)
	[ -n "$path_java" ] && java_ok "$path_java" && java=$path_java
fi
[ -n "$java" ] || die 127 "no suitable Java found. jdbx needs Java $REQUIRED_JAVA or newer. Set JDBX_JAVA to a java executable, or JAVA_HOME to a JDK $REQUIRED_JAVA+ directory, or put java $REQUIRED_JAVA+ on PATH."

jar=
if [ -n "$JDBX_JAR" ]; then
	jar=$JDBX_JAR
else
	for candidate in "$script_dir/jdbx.jar" "$script_dir/../lib/jdbx.jar"; do
		if [ -f "$candidate" ]; then jar=$candidate; break; fi
	done
	if [ -z "$jar" ]; then
		for candidate in "$script_dir"/../target/jdbx-*.jar; do
			case $candidate in *-sources.jar | *-javadoc.jar | *.original) continue ;; esac
			if [ -f "$candidate" ]; then jar=$candidate; break; fi
		done
	fi
	[ -n "$jar" ] || jar=$script_dir/../target/jdbx-*.jar
fi
[ -f "$jar" ] || die 1 "jar not found: $jar. Build it with './mvnw -DskipTests package' or set JDBX_JAR."

# shellcheck disable=SC2086  # JDBX_OPTS is word-split on purpose
exec "$java" $JDBX_OPTS -jar "$jar" "$@"
